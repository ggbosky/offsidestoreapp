# ─────────────────────────────────────────────────────────────
# Offsidestore Studio – lokální nastavení. Zkopírujte jako .env
# Soubor .env se NEcommituje a klíče zůstávají jen ve vašem PC.
# ─────────────────────────────────────────────────────────────

# Heslo k aplikaci (volitelné): npm run hash-password -- "MojeHeslo"
VITE_APP_PASSWORD_HASH=

# ── Claude (hledání trendů + nápady) ── https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# ── Shopify ──
# Subdoména obchodu (část před .myshopify.com – najdete v Shopify adminu v URL)
SHOPIFY_STORE=
# Nová aplikace z Dev Dashboardu (od 1. 1. 2026): Client ID + Client secret
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# …nebo starší vlastní aplikace z adminu s tokenem shpat_… (pak client ID/secret nevyplňujte)
SHOPIFY_ADMIN_TOKEN=
# SHOPIFY_API_VERSION=2026-07

# ── Gemini (úprava fotek ve stylu Jablkoňovny) ── https://aistudio.google.com → Get API key
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
